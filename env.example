# Copy this file to .env. Values already exported by the parent environment
# take precedence over values loaded from .env.

# Web server. Keep the example loopback-only; opt into remote development in
# your private .env by setting HOST=0.0.0.0 and TONGUES_ALLOW_INSECURE_REMOTE=1.
HOST=127.0.0.1
PORT=3000
HTTPS_PORT=8443
TONGUES_ALLOW_INSECURE_REMOTE=0

# Resident speech and preparation.
TONGUES_SPEECH_DEVICE=auto
TONGUES_SPEECH_MAX_IN_FLIGHT=2
TONGUES_PREPARE_THREADS=8
TONGUES_OFFLINE=0

# Local live-conversation provider.
OLLAMA_HOST=http://127.0.0.1:11434

# Uncomment for verbose Whisper diagnostics.
# SPEAKING_DEVELOPER_DIAGNOSTICS=1

# Optional model and tool overrides. Leave these unset unless the corresponding
# local artifact is installed; empty values are treated as configured paths by
# some runtimes.
# TONGUES_MODEL_HOME=/path/to/mortar-sea
# TONGUES_MODEL_CACHE=/path/to/model-download-cache
# TONGUES_MODEL_CATALOGS=/path/to/private-catalog.json
# TONGUES_WHISPER_MODEL=/path/to/ggml-whisper-model.bin
# TONGUES_TTS_WIKTIONARY_MODEL=/path/to/wiktionary-model
# TONGUES_UDPIPE_MODEL=/path/to/udpipe-model.udpipe
# TONGUES_UROMAN=/path/to/uroman.pl

# MBROLA databases have separate license terms. Set this only after confirming
# that your use is authorized.
# TONGUES_MBROLA_NATIVE_USE_AUTHORIZED=1
